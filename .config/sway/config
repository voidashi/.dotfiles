# =====================================================================
#  SWAY
# =====================================================================
# The alternative compositor to Hyprland, kept in parallel. The design guide's
# "consistency within a class" rule requires the theme to be mirrored between the
# two: same colour, terminal and launcher. See docs/design/RICE-GUIDE.md.
#
# Behaviour is mirrored too, and the direction is one way: this file follows
# .config/hypr/, never the reverse. Where a key means something under Hyprland it
# means the same thing here, which is why several binds below are not the ones
# sway ships with. What sway has and Hyprland has no counterpart for stays, as
# long as it does not sit on a key Hyprland has already spent.
#
# Four things are absent on purpose rather than forgotten, and only three of them
# because sway cannot express them: a SIGKILL bind, since `kill` is its only
# verb; a directional swap, since it swaps by criterion and not by direction, so
# the move binds recalculate the split tree the way the comment above binds.lua's
# arrow-key move binds describes; and pseudotiling. The fourth is a decision, not
# a limit. Sway has `bindswitch` and could bind the lid; it does not because no
# lid event should lock the screen, for the reason in docs/MAINTENANCE.md.
#
# The commented example blocks sway ships by default were removed: none held real
# config, together they ran to over forty lines, and it was among them that a dead
# palette block went unnoticed through the whole retheme. The output and input
# blocks below are real ones, carrying what hypr/conf/monitors.lua and
# hypr/conf/input.lua set. `man 5 sway` covers the rest.
#
# What none of this is: tested. `sway --validate` parses the file and stops there.
# It rejects a malformed directive (an `output` with a bad mode fails), and it
# accepts `bindsym $mod+x total_nonsense` in silence with exit 0, because a bind's
# command is only resolved when the key is pressed. So every bind here is
# unverified until someone boots sway. See docs/MAINTENANCE.md.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# The home-row direction variables sway ships with were removed along with the
# binds that read them. Nothing here uses h/j/k/l as a direction any more, and a
# variable no line reads is the kind of thing that survived in this file once
# already: a whole palette block, unreferenced, through an entire retheme.
# The same terminal and launcher Hyprland uses, in conf/programs.lua. They had
# diverged for no reason: foot and wmenu-run here, kitty and wofi there.
set $term kitty
set $menu wofi --show drun

### Output
#
# Mirrors hypr/conf/monitors.lua. This file had no output directive at all, so
# sway ran on defaults for both panels and the eDP-1 that the Hyprland lid binds
# name had no counterpart here to name.
#
# Sway has no catch-all output the way monitors.lua's empty-name entry is, and it
# does not need one: an output with no directive already comes up at its
# preferred mode, auto-positioned. So the third line there has nothing to mirror.
output eDP-1 mode 1920x1080@60Hz position 0,0 scale 1
output DP-1 mode 1920x1080@144Hz position 1920,0 scale 1

### Input
#
# Mirrors hypr/conf/input.lua, which this file had no equivalent of, so natural
# scrolling, flat acceleration and the keyboard layout were all simply unset
# under sway while being set under Hyprland.
#
# The two `0`s are the same idea in both: hypr's sensitivity and sway's
# pointer_accel are both an adjustment on a -1 to 1 scale, and 0 is none.
input type:keyboard {
    xkb_layout us
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
    left_handed disabled
}

input type:touchpad {
    accel_profile flat
    pointer_accel 0
    natural_scroll enabled
}

# hypr's follow_mouse = 1.
focus_follows_mouse yes

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window. Hyprland also binds $mod+Shift+q to a SIGKILL for a
    # hung application; sway has no second verb for that, so the key is unbound
    # here rather than aliased to the same graceful close.
    bindsym $mod+q kill

    # Start your launcher. $mod+r, not sway's default $mod+d, because $mod+r is
    # the launcher under Hyprland. The resize mode that used to hold this key is
    # on $mod+Shift+r below.
    bindsym $mod+r exec $menu

    # File managers, matching binds.lua. $mod+e is the graphical one, and its
    # shift is the terminal one inside $term.
    bindsym $mod+e exec dolphin
    bindsym $mod+Shift+e exec $term -e yazi

    # Clipboard history. Same key and same script as Hyprland: the pipeline is
    # identical for both, so it lives in one place instead of two.
    # backup-configs.sh install links the scripts/wm/ helpers into ~/.local/bin,
    # so this names a fixed location and not the clone directory. The path is
    # spelled out rather than left to PATH: a display-manager session reads no
    # shell profile, and a shell profile is the only thing that puts
    # ~/.local/bin on PATH here.
    bindsym $mod+Shift+v exec $HOME/.local/bin/clipboard-picker.sh

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit the session. $mod+m, matching binds.lua, because $mod+Shift+e is the
    # terminal file manager above. The confirmation stays: Hyprland's exit has
    # none, but a dialog is not a keybind and costs nothing to keep.
    bindsym $mod+m exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Arrow keys only, matching binds.lua. The home-row row sway ships with
    # ($mod+h/j/k/l) is gone, because $mod+j toggles the split under Hyprland and
    # it does so here now too. With it go the $left/$down/$up/$right variables,
    # which nothing reads once the resize mode is on arrows as well.
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window, same keys plus Shift.
    #
    # Hyprland binds `swap` here, which exchanges the window with its neighbour
    # and leaves the dwindle tree's geometry alone. Sway has no directional swap:
    # `swap container with` takes a criterion (mark, con_id, instance), not a
    # direction. So `move` stays, and it reinserts into the split tree, which
    # recalculates proportions and makes windows change size as they travel. That
    # difference is forced, not chosen. The comment above binds.lua's own
    # arrow-key move binds has the same trade-off written from the other side.
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

    # Scroll the mod key over the desktop to change workspace, as binds.lua does
    # with mouse_down and mouse_up. button4 is scroll up and button5 is down, so
    # the pairing reads inverted against the names Hyprland gives the same two.
    #
    # --whole-window is load-bearing. sway(5): "By default, mouse bindings are
    # only triggered when over the title bar", and default_border below is
    # `pixel 2`, which draws no title bar. Without the flag these two binds would
    # have a region of almost nothing to fire in, and would read as dead keys.
    # It also lets them fire over an empty workspace, which is where you would
    # most want to scroll away from.
    bindsym --whole-window $mod+button4 workspace prev
    bindsym --whole-window $mod+button5 workspace next
#
# Layout stuff:
#
    # Split direction. $mod+b keeps the horizontal split, which no Hyprland bind
    # wants. Vertical moves off $mod+v, which is the float toggle below.
    bindsym $mod+b splith
    bindsym $mod+Shift+b splitv

    # Switch the current container between layout styles. Sway is a manual tiler
    # and Hyprland is not, so most of this row has no counterpart and is a sway
    # extra. Two of them do have one and take its key:
    #   $mod+j  matches Hyprland's togglesplit
    #   $mod+g  matches Hyprland's group toggle, which is what tabs are there
    # Both are toggles because both of Hyprland's are. A bare `layout tabbed`
    # only goes one way, so pressing the key twice would leave you in tabs with
    # no way back on that finger, which is not what group.toggle does.
    # Stacking has no analogue at all, so it sits on the shift of tabbed and is
    # one-way on purpose.
    bindsym $mod+j layout toggle split
    bindsym $mod+g layout toggle tabbed split
    bindsym $mod+Shift+g layout stacking

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode. $mod+v, matching
    # binds.lua, not sway's $mod+Shift+space.
    bindsym $mod+v floating toggle

    # Swap focus between the tiling area and the floating area. Sway extra.
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container. Sway extra.
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # $mod+s and its shift, matching Hyprland's special:magic workspace, not
    # sway's $mod+minus pair. The two are not the same mechanism: Hyprland's
    # special workspace holds many windows and toggles as a set, while sway's
    # scratchpad show cycles through them one at a time. Same key, same intent,
    # different feel.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+s move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+s scratchpad show
#
# Resizing containers:
#
# Arrows only and Escape only, matching the "resize" submap in binds.lua. The
# home-row row and the Return exit that sway ships with are gone: Hyprland has
# neither, and a mode you leave two different ways is a mode whose exit you have
# to remember. The 10px step is the same on both sides.
mode "resize" {
    # Directions follow binds.lua's submap, which passes a positive delta to
    # grow: up grows the height and down shrinks it. Sway ships these two the
    # other way round, and they were left inverted here under a comment claiming
    # they matched. Left and right already agreed and are unchanged.
    bindsym Left resize shrink width 10px
    bindsym Down resize shrink height 10px
    bindsym Up resize grow height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Escape mode "default"
}
# $mod+Shift+r, not sway's $mod+r, which is the launcher above.
bindsym $mod+Shift+r mode "resize"
#
# Utilities:
#
    # Volume, through wpctl rather than pactl. Same 5% step as before; the change
    # is the backend. binds.lua drives wireplumber directly and this drove it
    # through the pulse shim, so the two could disagree about what a sink is.
    bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
    bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

    # Media transport. Absent here until now, bound under Hyprland since the
    # start, which is the shape most of this file's divergence took.
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next

    # Special keys to adjust brightness via brightnessctl
    # -e3 is load-bearing, not decoration: it makes the percentage a perceptual axis
    # instead of a raw one. Keep it in step with the same two binds in hypr/conf/binds.lua.
    bindsym --locked XF86MonBrightnessDown exec brightnessctl -e3 set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl -e3 set 5%+

    # Screenshots, on the same three keys binds.lua uses. Hyprland uses hyprshot,
    # which talks to hyprctl and cannot run here; grim and slurp are the
    # equivalents. Neither the output nor the window mode has a built-in form, so
    # both ask sway for a rectangle and hand it to grim.
    #
    # The -o on the output bind is load-bearing now that this file declares two
    # outputs. Measured on a headless sway with the two panels this config
    # places side by side: a bare `grim` writes 3840x1080, every output
    # composited into one image, while `grim -o <name>` writes 1920x1080, which
    # is what `hyprshot -m output` means by an output. The bind was bare here
    # before and was a single-monitor assumption nobody had written down.
    #
    # Two things still differ from hyprshot and are not worth a wrapper: it
    # copies to the clipboard and sends a notification, and these do not.
    #
    # A scripts/wm/screenshot.sh was considered, as the clipboard picker is
    # shared that way, and rejected: it would have to branch on the compositor
    # anyway, so it trades three lines here for a file plus a branch.
    #
    # The two jq lines are upstream's published form rather than ones written
    # here, because it is the quoting that is delicate, not the jq: a
    # double-quoted $(...) holding a single-quoted filter that itself contains
    # double quotes. Both filters were run against a real get_tree and a real
    # get_outputs. The quoting has been through `sway --validate`, which parses
    # the line and does not run it.
    bindsym Print exec grim -o "$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')"
    bindsym Shift+Print exec grim -g "$(slurp)"
    bindsym $mod+Print exec grim -g "$(swaymsg -t get_tree | jq -j '.. | select(.type?) | select(.focused).rect | "\(.x),\(.y) \(.width)x\(.height)"')"

#
# Status Bar:
#
# The bar is waybar, launched from the Autostart section below with sway.jsonc.
# The swaybar example block that used to sit here was removed: it was commented
# out, would never be used, and carried four colours from outside the palette.

#
# Appearance
#
# Border width matches appearance.lua's border_size = 2. Floating windows take a
# plain border too, not sway's default `normal`, which draws a titlebar: nothing
# under Hyprland has one.
default_border pixel 2
default_floating_border pixel 2

# smart_borders replaces `hide_edge_borders smart`, and this is a rename rather
# than a change: sway(5) says the smart option of hide_edge_borders is
# "equivalent to setting smart_borders smart and hide_edge_borders none". So the
# old line was already doing this and nothing was dropped. It is spelled out
# because the behaviour is what window_rules.lua asks for on the Hyprland side,
# where border_size goes to 0 on a workspace holding one window (w[tv1], f[1]),
# and a rule worth mirroring should be legible as itself.
smart_borders on

# smart_gaps is the other half of those same workspace rules, which zero gaps_in
# and gaps_out for a single window.
smart_gaps on

# Gaps. Not a copy of Hyprland's numbers, because the two count differently.
# Measured rather than reasoned about, on a headless sway with two tiled windows
# on a 1920x1080 output, reading the rects back out of `swaymsg -t get_tree`:
#
#   inner  3 outer  7  ->  edge 10, between 3
#   inner  6 outer  4  ->  edge 10, between 6
#   inner 10 outer  0  ->  edge 10, between 10
#
# So sway's inner is the whole gap BETWEEN two windows, and the screen edge is
# inner + outer. Hyprland's gaps_in is a per-window inset, so its 3 shows as 6
# between two windows, and gaps_out = 10 is the edge. inner 6 / outer 4 is
# therefore the pair that mirrors it.
#
# sway(5) calls inner "spacing around each window", which reads as a per-window
# inset and is what an earlier version of this comment computed from. It gave
# inner 3, which is half the gap Hyprland has. Do not re-derive these from that
# sentence; re-measure if you change them.
#
# Confirmed on this machine with sway actually running, two windows side by side
# on a 1920 output: gap between them 6, left edge 10, right edge 10, which is
# what the headless numbers predicted and what Hyprland shows.
#
# One rule is knowingly broken. docs/design/RICE-GUIDE.md asks for gaps that are
# even and drawn from the spacing scale 4, 8, 12, 16, 24. 4 is on it and 6 is
# not. Parity with Hyprland won, because Hyprland's own 3 and 10 do not satisfy
# that rule either and matching a sibling beats half-satisfying a scale in one
# compositor. TODO.md carries the conflict.
gaps inner 6
gaps outer 4


#
# Theme
#

# Colours. These mirror .config/hypr/conf/appearance.lua, because the guide asks
# for the theme to be mirrored across both compositors: focus in Ice, inactive in
# edge-30, surfaces on the void scale. See docs/design/THEMING.md.
#
# The block that used to sit here carried Kanagawa's 41 colours as variables and
# used none of them: there was not a single client.* directive in the file, so
# Sway ran on its factory colours while the repo appeared to be themed. The nine
# that replaced it were correct and hand-pasted, so they could only follow
# palette.json by someone remembering to edit both.
#
# The path is relative to this file, which is how sway resolves an include.
include voidashi-colors

# client.<state> <border> <background> <text> <indicator> <child-border>
# The indicator shows where the next window opens, so it takes Ice too: it is focus.
client.focused          $vd_focus $vd_bg_window $vd_text_bright $vd_focus $vd_focus
client.focused_inactive $vd_unfocused $vd_bg_window $vd_text_body $vd_unfocused $vd_unfocused
client.unfocused        $vd_unfocused $vd_bg_content $vd_text_disabled $vd_unfocused $vd_unfocused
client.urgent           $vd_urgent $vd_bg_window $vd_text_bright $vd_urgent $vd_urgent
client.placeholder      $vd_border $vd_bg_content $vd_text_body $vd_border $vd_border
client.background       $vd_bg_content


#
# Autostart
#
# uwsm, when the session was started through it, needs this to export
# WAYLAND_DISPLAY into the systemd user manager and report the compositor unit as
# started. Without it the unit sits in activating and times out. It is first
# because everything below is launched by a manager that wants the session up.
#
# Unconditional on purpose. Measured in a plain sway session started directly by
# the greeter: it prints one line to stderr saying it could not find an
# activating Wayland session, and exits 0. So the cost of the line when uwsm is
# not in use is a journal entry, and the cost of guarding it is a condition that
# has to stay correct.
#
# Why uwsm is involved at all: a greeter that execs the compositor never makes it
# a systemd user unit, so ~/.config/environment.d/ is read and never handed over,
# and Qt applications come up unthemed. See docs/TODO.md.
exec uwsm finalize

# Radio and network, both of which autostart.lua has started since the beginning
# and this file did not. Same order as there.
exec rfkill block bluetooth
exec nm-applet

# Both compositors pass -c/-s explicitly: neither bar is "the default one",
# and the module list is the only thing that differs between them.
exec waybar -c $HOME/.config/waybar/sway.jsonc -s $HOME/.config/waybar/style.css
# In order: the wallpapers in rotation, then the full collection, then the
# repo's own sample wallpaper (which is what makes a fresh install work).
exec swaybg -m fill -i "$($HOME/.local/bin/select-random-wallpaper.sh $HOME/Pictures/Current_wallpapers $HOME/Pictures/Wallpapers $HOME/.local/share/wallpapers/dotfiles)"

# Environment. Sway has no `env` directive, and an `exec` cannot change its own
# parent's environment, so the session variables this desktop needs live in
# ~/.config/environment.d/50-voidashi.conf, which systemd --user reads at login.
# That is where QT_QPA_PLATFORMTHEME=kde comes from; without it Qt applications
# come up light against a dark desktop. See docs/MAINTENANCE.md.

# Notifications. Hyprland starts swaync from conf/autostart.lua and this file
# started nothing, so notifications were dead under Sway while the config and
# the stylesheet sat themed and in place, with no error anywhere to say so.
exec swaync

# Clipboard history, cleared at every session start. wl-paste --watch is the only
# thing that feeds cliphist, so without this line the picker on $mod+Shift+v opens
# an always-empty menu. The wipe runs first and in the same shell so the order
# cannot invert. Keep in step with hypr/conf/autostart.lua.
exec sh -c 'cliphist wipe; exec wl-paste --watch cliphist store'

# Idle. swayidle has no config file: this schedule is the whole configuration,
# which is why it is here and not beside hypr/hypridle.conf. The numbers are
# deliberately the same as that file's, and both hand off to the same swaylock.
# The middle timeout is the lock's plus sixty seconds on purpose, so the screen
# blanks after the lock rather than with it. Move one and move the other.
#
# Under systemd-cat, for the reason autostart.lua wraps hypridle. That incident
# was Hyprland's, not this file's: hypridle writes only to stdout, nothing
# captured it, and a night of unexplained locks had to be reconstructed from
# suspend and PAM lines in the journal because no timeout had left a record.
#
# -d is half of that wrapper and not a debugging leftover. swayidle does not log
# its timeouts at default verbosity, which hypridle does, so the tag alone buys
# almost nothing. Measured: `systemd-cat -t X swayidle -w timeout 1 true` puts
# one startup warning in the journal and nothing when the timeout fires, while
# the same line with -d logs "Cmd exec" for every one. Without it the 900 lock
# and the 1800 suspend leave no record at all, which is exactly the evening this
# wrapper exists to prevent. With it, `journalctl -t swayidle` shows each
# timeout with a time.
#
# `lock` is the handler logind's Lock signal reaches, so `loginctl lock-session`
# on the 900 timeout routes through it the way hypridle's lock_cmd does, and the
# pidof guard means a second request does not stack a second locker.
#
# before-sleep is the deliberate exception and calls swaylock directly. Going
# through loginctl there would return immediately, and -w is the flag that makes
# swayidle hold the suspend until the locker is actually up; handing it a command
# that exits at once defeats it. The guard still applies.
exec systemd-cat -t swayidle swayidle -d -w \
    lock 'pidof swaylock || swaylock -f' \
    timeout 900 'loginctl lock-session' \
    timeout 960 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    timeout 1800 'systemctl suspend' \
    before-sleep 'pidof swaylock || swaylock -f' \
    after-resume 'swaymsg "output * power on"'


include @sysconfdir@/sway/config.d/*
