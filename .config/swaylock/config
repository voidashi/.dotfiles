ignore-empty-password
disable-caps-lock-text
# Serif is welcome exactly here (RICE-GUIDE.md: "the one place the editorial
# voice is welcome" -- lockscreens, greeters, fetch banners, nowhere else).
font=Spectral

screenshots
effect-blur=7x5
effect-vignette=0.5:0.5
indicator
indicator-radius=120
indicator-thickness=20
clock
timestr=%I:%M %p
datestr=%A, %d %B

