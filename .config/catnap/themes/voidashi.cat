; GENERATED by scripts/theme/generate_theme.py from scripts/theme/palette.json
; Do not hand-edit: edit palette.json and rerun the generator.
; Voidashi color scheme. See docs/design/RICE-GUIDE.md

; The ANSI table verbatim, which is what the art in distros.cat names.
$black          = #191817
$red            = #b44955
$green          = #4e9162
$yellow         = #a57636
$blue           = #498bb2
$magenta        = #9270a7
$cyan           = #459192
$white          = #b1b1b1
$bright_black   = #4f4d4a
$bright_red     = #e14b39
$bright_green   = #6da97d
$bright_yellow  = #d89529
$bright_blue    = #6aa3c7
$bright_magenta = #a98abc
$bright_cyan    = #64a9a9
$bright_white   = #e8e8e8

; Roles, named by what a row means rather than by rotation. The same
; assignment the fastfetch presets use: identity on who and where, function
; on what the system is, duration on how long, and no family on a count.
$identity = #b44955
$function = #498bb2
$duration = #4e9162
$quantity = #6c6c6c
$value    = #b1b1b1

; What catnap paints without being asked: the value column and the frame.
$text_color   = $value
$border_color = #393835
