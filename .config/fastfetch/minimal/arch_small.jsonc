// Voidashi, restrained variant: one accent family, Bordeaux, and nothing else.
//
// A variant, not a snapshot. It takes the guide's other reading of a fetch, as
// the desktop's cover page: a cover page wants a single focal point, which here
// is the logo and the name, with the whole table in ink.
//
// The versions one level up take the reading that a family may appear on the
// rows that mean it: Bordeaux identity, Ice function, Moss duration, Ash media.
// Both are legitimate under the guide and this is a matter of taste, which is
// why both are live. Neither is the other's history.
//
// Use one with: fastfetch -c ~/.config/fastfetch/minimal/<file>
// For the fish greeter, edit the fastfetch line in .config/fish/config.fish.
//
// Nothing keeps the two in step. Add a module to the preset one level up and
// add it here too, or the variant stops being the same fetch. No check reports
// the difference: verify.sh renders every config and reads stderr, which proves
// each one parses and says nothing about what the two contain.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        // arch_small paints from two slots. Setting only the first left the
        // bottom third of the logo on its default cyan.
        "color": {
            "1": "#b44955", // bordeaux-400
            "2": "#99303f"  // bordeaux-500
        },
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#6c6c6c",      // ink-4, metadata
            "title": "#b44955",     // bordeaux-400, the identity mark
            "output": "#b1b1b1",    // ink-2, body text
            "separator": "#4f4d4a"  // edge-40
        },
        // fastfetch colours a percentage green, yellow or red by threshold, and
        // the memory line came out green at 16%. Green is in the palette, but
        // that is an accent spent at rest on nothing, which is the difference
        // between a rice and a dashboard. The digits carry the information; the
        // number stays ink.
        "percent": {
            "type": ["num"]
        }
    },
    "modules": [
        "break",
        "title",
        {
            "type": "os",
            "key": "os    "
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "host",
            "format": "{5} {1}",
            "key": "host  "
        },
        {
            "type": "packages",
            "key": "pkgs  "
        },
        {
            "type": "memory",
            "key": "memory"
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "uptime"
        },
        "break"
    ]
}
