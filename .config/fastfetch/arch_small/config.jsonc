// Preset structure from FastCat: https://github.com/m3tozz/FastCat
// The colours are Voidashi, not FastCat's.
//
// This is the live one: fish runs it as the greeter, from config.fish.
//
// What it used to do, measured with `fastfetch --pipe false | cat -v`: the logo
// and title came out ESC[36m, cyan, which in our ANSI table is Verdigris, and
// the guide says outright that Verdigris exists for ANSI slots 6 and 14 and for
// syntax highlighting, not as a UI accent. The keys came out ESC[1m ESC[33m,
// bold yellow, which resolves to bright yellow, which is alert-caution: an alert
// tone used as decoration, and the alert tones are kept separate precisely so
// that "needs attention" never reads as branding.
//
// A greeter is an identity surface (RICE-GUIDE.md, Application classes), so the
// identity mark is what belongs: Bordeaux on the logo and the title, ink for
// everything else, one accent family visible at rest.
//
// Values are hex rather than the ANSI codes fastfetch also accepts, so that
// check_palette.py can see them. Written as 38;2;180;73;85 the same colour would
// be invisible to the checker.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        // arch_small paints from two slots. Setting only the first left the
        // bottom third of the logo on its default cyan.
        "color": {
            "1": "#b44955", // bordeaux-400
            "2": "#99303f"  // bordeaux-500
        },
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#6c6c6c",      // ink-4, metadata
            "title": "#b44955",     // bordeaux-400, the identity mark
            "output": "#b1b1b1",    // ink-2, body text
            "separator": "#4f4d4a"  // edge-40
        },
        // fastfetch colours a percentage green, yellow or red by threshold, and
        // the memory line came out green at 16%. Green is in the palette, but
        // that is an accent spent at rest on nothing, which is the difference
        // between a rice and a dashboard. The digits carry the information; the
        // number stays ink.
        "percent": {
            "type": ["num"]
        }
    },
    "modules": [
        "break",
        "title",
        {
            "type": "os",
            "key": "os    "
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "host",
            "format": "{5} {1}",
            "key": "host  "
        },
        {
            "type": "packages",
            "key": "pkgs  "
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "uptime"
        },
        {
            "type": "memory",
            "key": "memory"
        },
        "break"
    ]
}
