// Preset structure from FastCat: https://github.com/m3tozz/FastCat
// The colours are Voidashi, not FastCat's.
//
// Dormant preset: nothing runs this. fish runs arch_small as the greeter and
// bare fastfetch reads ../config.jsonc. It is aligned anyway, because the guide
// requires consistency within a class and a preset that has drifted is a preset
// that comes back wrong the day it is switched on.
//
// It used to set "keyColor": "34" on every module, ANSI blue, which is ice-400.
// Ice is the focus colour everywhere on this desktop, and a fetch has nothing
// focused; Bordeaux is the identity mark a fetch is for. Hex rather than ANSI
// codes so check_palette.py can see the values.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "$HOME/.config/fastfetch/crow/ascii.txt",
    	"color": { "1": "#b44955" }, // bordeaux-400
    	"padding": {
    		"top": 1,
        "right": 2
    	},
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#6c6c6c",      // ink-4, metadata
            "title": "#b44955",     // bordeaux-400, the identity mark
            "output": "#b1b1b1",    // ink-2, body text
            "separator": "#4f4d4a"  // edge-40
        },
        // A percentage coloured green, yellow or red by threshold is an accent
        // spent at rest on nothing. The digits carry the information.
        "percent": {
            "type": ["num"]
        }
    },
    "modules": [
	"break",
        "break",
        "break",
	      {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
        },
        {
            "type": "kernel",
            "key": " ",
        },
        {
            "type": "packages",
            "key": " ",
        },
        {
            "type": "shell",
            "key": " ",
        },
        {
            "type": "terminal",
            "key": " ",
        },
        {
            "type": "wm",
            "key": " ",
        },
        {
            "type": "cursor",
            "key": " ",
        },
        {
            "type": "terminalfont",
            "key": " ",
        },
        {
            "type": "uptime",
            "key": " ",
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
        },
        {
            "type": "media",
            "key": "󰝚 ",
        },
        {
            "type": "player",
            "key": " ",
        },
        "break",
        "colors",
        "break",
        "break",
    ]
}