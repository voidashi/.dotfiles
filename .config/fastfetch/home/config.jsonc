// Preset structure from FastCat: https://github.com/m3tozz/FastCat
// The colours are Voidashi, not FastCat's.
//
// Dormant preset: nothing runs this. fish runs arch_small as the greeter and
// bare fastfetch reads ../config.jsonc. Aligned anyway, because the guide asks
// for consistency within a class.
//
// This one was the worst of the four. Every row carried its own inline colour,
//  through  cycling per line, which is the "every module a different
// colour" anti-pattern named in both the guide and the aesthetic direction, and
// six accent families visible at once against a budget of two. The frame, the
// glyph and the label now all sit at ink-4 and the title carries the only
// accent, which is Bordeaux.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#6c6c6c",      // ink-4, and the box frame with it
            "title": "#b44955",     // bordeaux-400, the identity mark
            "output": "#b1b1b1",    // ink-2, body text
            "separator": "#4f4d4a"  // edge-40
        },
        "percent": {
            "type": ["num"]
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│  user    │",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ 󰇅 hname   │",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ 󰅐 uptime  │",
            "type": "uptime"
        },
        {
            "key": "│ {icon} distro  │",
            "type": "os"
        },
        {
            "key": "│  kernel  │",
            "type": "kernel"
        },
        {
            "key": "│ 󰇄 desktop │",
            "type": "de"
        },
        {
            "key": "│  term    │",
            "type": "terminal"
        },
        {
            "key": "│  shell   │",
            "type": "shell"
        },
        {
            "key": "│ 󰍛 cpu     │",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ 󰉉 disk    │",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│  memory  │",
            "type": "memory"
        },
        {
            "key": "│ 󰩟 network │",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│  colors  │",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
