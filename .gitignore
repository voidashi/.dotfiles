# Log written on every run of scripts/install-packages.sh
# (the script overwrites the file at the start of each run).
package_install.log

# Iosevka's full-family .ttc build is ~431MB (9 files bundling every width/weight).
# Too large to version; install locally and symlink into ~/.local/share/fonts instead.
# See the Fonts section of docs/SETUP.md.
fonts/Iosevka/

# Python bytecode from scripts/theme/. Interpreter and machine specific, and it
# had been tracked by accident, so every edit to generate_theme.py showed up as
# a binary diff beside the real one.
__pycache__/
*.pyc

# Everything an AI coding agent keeps lives here and none of it belongs to anyone
# who clones this. The checks it used to hold are in scripts/verify.sh, which is
# tracked, so nothing is lost by ignoring the directory.
#
# Note this rule cannot un-track what is already tracked: git ignores .gitignore
# for a path in the index. An agent worktree was committed as a gitlink twice,
# the second time when a merge kept the side of the history that still had it,
# and only the guard in scripts/verify.sh catches that.
.claude/
